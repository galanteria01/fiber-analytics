# =============================================================================
# FiberAnalytics environment
# Copy to `.env` (root, used by docker-compose) and/or
# `apps/dashboard/.env.local` for `pnpm dev`. All values below are optional;
# the defaults shown make local-first development work with zero config.
# =============================================================================

# --- Storage -----------------------------------------------------------------
# local (filesystem, default) | s3 (AWS S3 or MinIO)
FA_STORAGE=local
# Local adapter: directory that holds raw/processing/analytics prefixes.
# FA_DATA_DIR=./data

# S3 adapter (FA_STORAGE=s3). For MinIO set the endpoint + path-style.
# FA_S3_BUCKET=fiber-analytics
# FA_S3_REGION=us-east-1
# FA_S3_ENDPOINT=http://minio:9000
# FA_S3_ACCESS_KEY_ID=minioadmin
# FA_S3_SECRET_ACCESS_KEY=minioadmin
# FA_S3_FORCE_PATH_STYLE=true
# FA_S3_PREFIX=

# --- Ingestion edge (apps/dashboard /api/ingest) -----------------------------
# Comma-separated allowlists. Empty = allow all (dev only — set these in prod).
# FA_ALLOWED_ORIGINS=https://app.example.com
# FA_ALLOWED_DOMAINS=app.example.com
FA_MAX_BODY_BYTES=262144
FA_MAX_EVENTS=500
FA_RATE_LIMIT_RPM=600
FA_IP_HEADER=x-forwarded-for
# Secret used to derive the daily, cookieless session hash. CHANGE IN PROD.
FA_DAILY_SECRET=change-me
# How long to retain analytics partitions (worker prunes older data).
FA_RETENTION_DAYS=90

# --- Dashboard auth ----------------------------------------------------------
# Auth is disabled until FA_DASHBOARD_PASSWORD is set (or FA_AUTH_DISABLED=true).
# FA_DASHBOARD_USER=admin
# FA_DASHBOARD_PASSWORD=change-me
# FA_AUTH_SECRET=change-me-too
# FA_AUTH_DISABLED=false

# --- Worker ------------------------------------------------------------------
FA_WORKER_INTERVAL_MS=4000
FA_COMPACTION_THRESHOLD=8

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
FA_LOG_LEVEL=info

# --- Demo app (apps/demo) ----------------------------------------------------
# Where the demo SDK ships events. Defaults to the local dashboard route.
# VITE_FA_ENDPOINT=http://localhost:3000/api/ingest
