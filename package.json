{
  "name": "fiberanalytics",
  "version": "0.1.0",
  "private": true,
  "description": "Component-aware UI analytics framework — auto-tagging, cookieless sessions, Parquet + DuckDB.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm build:packages && pnpm --filter dashboard build",
    "dev": "pnpm build:packages && concurrently -n demo,dashboard -c cyan,magenta \"pnpm --filter demo dev\" \"pnpm --filter dashboard dev\"",
    "dev:demo": "pnpm --filter demo dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "sync": "pnpm --filter worker once",
    "worker": "pnpm --filter worker start",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset:version": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "@changesets/cli": "^2.29.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/fiber-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/fiber-analytics/issues"
  },
  "homepage": "https://github.com/galanteria01/fiber-analytics#readme",
  "author": "Shoury Sharma <shoury.sharma@nutanix.com>",
  "keywords": [
    "analytics",
    "react",
    "compiler",
    "babel",
    "privacy",
    "duckdb",
    "parquet",
    "session-journey",
    "component-analytics",
    "cookieless"
  ]
}
