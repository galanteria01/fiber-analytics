{
  "name": "@fiber-analytics/vite-plugin",
  "version": "0.1.0",
  "description": "Vite/Babel compiler plugin that auto-tags interactive JSX for FiberAnalytics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/fiber-analytics.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/fiber-analytics/issues"
  },
  "homepage": "https://github.com/galanteria01/fiber-analytics/tree/main/packages/vite-plugin#readme",
  "author": "Shoury Sharma <shoury.sharma@nutanix.com>",
  "keywords": [
    "analytics",
    "react",
    "vite",
    "privacy",
    "component-analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@fiber-analytics/core": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
