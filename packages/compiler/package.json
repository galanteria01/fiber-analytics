{
  "name": "@fiber-analytics/compiler",
  "version": "0.1.0",
  "description": "Babel transform that auto-tags interactive JSX for FiberAnalytics — works with any bundler.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/fiber-analytics.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/fiber-analytics/issues"
  },
  "homepage": "https://github.com/galanteria01/fiber-analytics/tree/main/packages/compiler#readme",
  "author": "Shoury Sharma <shoury.sharma@nutanix.com>",
  "keywords": [
    "analytics",
    "react",
    "babel",
    "compiler",
    "privacy",
    "component-analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@fiber-analytics/core": "workspace:*",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
