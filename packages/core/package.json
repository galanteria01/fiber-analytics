{
  "name": "@fiber-analytics/core",
  "version": "0.1.0",
  "description": "Shared types, schema, and constants for FiberAnalytics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/fiber-analytics.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/fiber-analytics/issues"
  },
  "homepage": "https://github.com/galanteria01/fiber-analytics/tree/main/packages/core#readme",
  "author": "Shoury Sharma <shoury.sharma@nutanix.com>",
  "keywords": [
    "analytics",
    "react",
    "privacy",
    "component-analytics",
    "cookieless"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
