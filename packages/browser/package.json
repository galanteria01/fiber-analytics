{
  "name": "@fiber-analytics/browser",
  "version": "0.1.0",
  "description": "Lightweight, non-blocking telemetry tracker for FiberAnalytics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/galanteria01/fiber-analytics.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/galanteria01/fiber-analytics/issues"
  },
  "homepage": "https://github.com/galanteria01/fiber-analytics/tree/main/packages/browser#readme",
  "author": "Shoury Sharma <shoury.sharma@nutanix.com>",
  "keywords": [
    "analytics",
    "react",
    "privacy",
    "component-analytics",
    "cookieless",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiber-analytics/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
